<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kms.App.Views.ShellView"
             Focusable="True"
             FontFamily="Microsoft YaHei UI, Segoe UI"
             Background="{DynamicResource Kms.Background}">
  <Grid>
    <Image x:Name="ThemeBackdrop"
           Stretch="UniformToFill"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch"
           IsHitTestVisible="False" />
    <Border x:Name="ThemeScrim" IsHitTestVisible="False" />
    <Grid ColumnDefinitions="240,*">
      <Border Grid.Column="0"
              Background="{DynamicResource Kms.Sidebar}"
              BorderBrush="{DynamicResource Kms.Line}"
              BorderThickness="0,0,1,0">
        <DockPanel Margin="16,20,16,14">
          <StackPanel DockPanel.Dock="Top" Spacing="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
              <Border Width="44" Height="44" CornerRadius="12">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="{DynamicResource Kms.AccentColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource Kms.CyanColor}" Offset="0.55" />
                    <GradientStop Color="{DynamicResource Kms.PurpleColor}" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <Grid Width="20" Height="20"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      ColumnDefinitions="8,8" RowDefinitions="8,8"
                      ColumnSpacing="4" RowSpacing="4">
                  <Border Background="{DynamicResource Kms.OnAccent}" CornerRadius="2.5" />
                  <Border Grid.Column="1" Background="{DynamicResource Kms.OnAccent}" CornerRadius="2.5" Opacity="0.9" />
                  <Border Grid.Row="1" Background="{DynamicResource Kms.OnAccent}" CornerRadius="2.5" Opacity="0.9" />
                  <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Kms.OnAccent}" CornerRadius="2.5" Opacity="0.75" />
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="键鼠统计"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource Kms.Text}" />
                <TextBlock Text="ACTIVITY MONITOR"
                           FontSize="8" LetterSpacing="1.3"
                           Foreground="{DynamicResource Kms.Muted}" />
              </StackPanel>
            </Grid>

            <Border Height="1" Margin="0,6,0,2"
                    Background="{DynamicResource Kms.Line}" />

            <TextBlock Text="数据分析"
                       Margin="4,0,0,0"
                       FontSize="10" FontWeight="SemiBold" LetterSpacing="1.1"
                       Foreground="{DynamicResource Kms.Muted}" />
            <StackPanel x:Name="NavPanel" Spacing="4" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Spacing="10">
            <TextBlock x:Name="ThemeLabel" Text="外观"
                       Margin="4,0,0,0"
                       FontSize="10" FontWeight="SemiBold" LetterSpacing="1.1"
                       Foreground="{DynamicResource Kms.Muted}" />
            <WrapPanel x:Name="ThemePanel" ItemWidth="26" ItemHeight="24" />

            <Border Height="1" Background="{DynamicResource Kms.Line}" Margin="2,2" />

            <StackPanel Spacing="3">
              <TextBlock Text="1–9 / ← →   切换页面"
                         Margin="4,0,0,0"
                         FontSize="8.5"
                         Foreground="{DynamicResource Kms.Muted}" />
              <TextBlock Text="Esc   返回 / 关闭"
                         Margin="4,0,0,0"
                         FontSize="8.5"
                         Foreground="{DynamicResource Kms.Muted}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="7" Margin="4,2,0,0">
              <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="{DynamicResource Kms.Green}"
                       VerticalAlignment="Center" />
              <TextBlock x:Name="Footer"
                         FontSize="8.5"
                         Foreground="{DynamicResource Kms.Muted}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <ContentControl x:Name="PageHost" Grid.Column="1" Margin="0,10,0,0" />
    </Grid>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="11,9" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Kms.Muted}" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kms.Raised}" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="{DynamicResource Kms.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Kms.OnAccent}" />
    </Style>
    <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kms.Accent}" />
    </Style>
    <Style Selector="Button.swatch">
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,4,4" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>
</UserControl>
