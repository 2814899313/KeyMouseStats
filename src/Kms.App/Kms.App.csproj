<Project Sdk="Microsoft.NET.Sdk">

  <!-- 应用外壳：Avalonia 窗口、9 个页面、悬浮窗与托盘。 -->
  <!-- Version / InformationalVersion 由根 Directory.Build.props 统一提供（4.2.0）。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app-icon.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kms.Core\Kms.Core.csproj" />
    <ProjectReference Include="..\Kms.Storage\Kms.Storage.csproj" />
    <ProjectReference Include="..\Kms.Input\Kms.Input.csproj" />
    <ProjectReference Include="..\Kms.Render\Kms.Render.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\app-icon.ico" Link="Assets/app-icon.ico" />
    <AvaloniaResource Include="..\..\assets\*.jpg" Link="Assets\Theme\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kms.Golden.Tests" />
  </ItemGroup>

</Project>
