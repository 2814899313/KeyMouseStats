# Local tooling and editor state
.opensquilla/
.workbuddy/
.tools/
.vs/
.vscode/
.idea/
*.user
*.suo

# Build outputs and local releases
*.exe
*.pdb
*.dll
# v3.0:内嵌进主 exe 的原生 SQLite 引擎 —— 「单文件绿色软件」唯一的原生依赖,
# 必须随仓库分发,否则 CI 上 build.bat 找不到资源会直接失败。
!assets/native/**/*.dll
*.obj
*.cache
*.log
*.tmp
bin/
obj/
# 单文件发布产物(几十 MB 的 exe),只该出现在 CI artifact 里,不进仓库
artifacts/

# Generated visual checks and bulk previews
previews/
tests/*.png

# Experimental utilities that are not part of the product build
text-input-demo/

# 本地数据恢复留档与一次性调试产物(不进仓库)
/_recovery/
# v4 重写用的真实数据样本(含真实窗口标题/进程路径,必须清洗后才能入库)
/_fixtures/
/.tmp-*/
/_head_*.cs
/_fixed_*.cs
/_fix_tests.py
/_apply_subdir.ps1
/_unzstd.js
/_dev.bat
/_sess_*.jsonl
/_err.txt
/_run.txt
/_s.txt
/_p.txt
/_r.txt
/_l.txt
/_st.txt

# 根目录设计过程截图(文档用图放在 docs/screenshots)
/*.png

# 本地内部研究、计划与真实输出样本，不随仓库发布
/docs/internal/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

