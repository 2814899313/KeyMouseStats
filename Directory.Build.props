<Project>

  <!--
    v4 公共构建属性。
    版本号唯一来源：本文件。Version / InformationalVersion 显式固定为 4.2.2-pre，
    AssemblyInformationalVersion 由 SDK 自动生成，Kms.Core 的 BuildInfo 从这里读取。
    release-v4.yml 会校验 Kms.App.exe 的 ProductVersion 与标签（去掉前缀 v）完全一致，
    因此预发布必须写成 4.2.2-pre（带连字符），标签对应 v4.2.2-pre。
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <VersionPrefix>4.2.2</VersionPrefix>
    <Version>4.2.2-pre</Version>
    <InformationalVersion>4.2.2-pre</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <Product>键鼠统计</Product>
    <Company>KeyMouseStats</Company>
    <Copyright>Copyright © 2026 KeyMouseStats</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>

    <!-- Avalonia headless 的 Dispatcher 是进程级单线程；测试程序集串行执行，避免线程亲和性假失败。 -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)test.runsettings</RunSettingsFilePath>
  </PropertyGroup>

</Project>
